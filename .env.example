# Server
PORT=3000

# Gemini API key
GEMINI_API_KEY= YOUR API KEY HERE

# Gemini model used to generate chat answers
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Gemini model used to generate embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Dimensionality of the embedding vectors. Smaller is faster to store/search, larger can be more precise. EMBEDDING_DIMENSIONS=768

# ChromaDB server connection (see README for how to start this locally)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=knowledge_base

# Upload limits
MAX_FILE_SIZE_BYTES=10485760

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL_SIZE=10
